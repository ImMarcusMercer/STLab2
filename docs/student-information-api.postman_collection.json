{
  "info": {
    "_postman_id": "9f1c9f40-3d4e-4b6a-9e02-1ad9c1f0b3a2",
    "name": "Student Information Management API",
    "description": "Demonstration collection for the Student Information Management REST API. Base URL http://127.0.0.1:8000/api/v1. Authenticate first (Auth/Login) and the token is stored in `token`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base", "value": "http://127.0.0.1:8000/api/v1" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success) { pm.collectionVariables.set('token', json.data.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@demo.edu\",\n  \"password\": \"DemoPass2026!\"\n}"
            },
            "url": "{{base}}/auth/login"
          }
        },
        {
          "name": "Login (student) - role check",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan.santos.1@student.demo.edu\",\n  \"password\": \"DemoPass2026!\"\n}"
            },
            "url": "{{base}}/auth/login"
          }
        },
        {
          "name": "Login - wrong password (FAIL expected 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@demo.edu\",\n  \"password\": \"wrong-password\"\n}"
            },
            "url": "{{base}}/auth/login"
          }
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Token {{token}}" }],
            "url": "{{base}}/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Token {{token}}" }],
            "url": "{{base}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "List students (search+filter+sort+pagination)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Token {{token}}" }],
            "url": {
              "raw": "{{base}}/students?search=dela&year_level=3&status=ACTIVE&sort=last_name&page=1&per_page=10",
              "query": [
                { "key": "search", "value": "dela" },
                { "key": "year_level", "value": "3" },
                { "key": "status", "value": "ACTIVE" },
                { "key": "sort", "value": "last_name" },
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Create student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Token {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_number\": \"2026-88888\",\n  \"first_name\": \"Ana\",\n  \"middle_name\": \"\",\n  \"last_name\": \"Reyes\",\n  \"birth_date\": \"2004-03-12\",\n  \"email\": \"ana.reyes@demo.edu\",\n  \"contact_number\": \"09171234567\",\n  \"address\": \"123 Mabini St., Manila\",\n  \"program_id\": 1,\n  \"year_level\": 2,\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{base}}/students"
          }
        },
        {
          "name": "Retrieve student",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Token {{token}}" }],
            "url": "{{base}}/students/1"
          }
        },
        {
          "name": "Update student (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Token {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"last_name\": \"Ramos\"\n}"
            },
            "url": "{{base}}/students/1"
          }
        },
        {
          "name": "Duplicate student number (FAIL expected 422)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Token {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_number\": \"2026-88888\",\n  \"first_name\": \"Ana\",\n  \"last_name\": \"Reyes\",\n  \"program_id\": 1,\n  \"year_level\": 2,\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{base}}/students"
          }
        },
        {
          "name": "Invalid email (FAIL expected 422)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Token {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_number\": \"2026-88889\",\n  \"first_name\": \"Ana\",\n  \"last_name\": \"Reyes\",\n  \"email\": \"not-an-email\",\n  \"program_id\": 1,\n  \"year_level\": 2,\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{base}}/students"
          }
        },
        {
          "name": "Not found (FAIL expected 404)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Token {{token}}" }],
            "url": "{{base}}/students/99999"
          }
        },
        {
          "name": "Student academic record",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Token {{token}}" }],
            "url": "{{base}}/students/1/academic-record"
          }
        }
      ]
    },
